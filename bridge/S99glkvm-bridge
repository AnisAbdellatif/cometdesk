#!/bin/sh
# glkvm-bridge: USB link for the target (no NAT, no routing) + relay daemon.
# The RNDIS gadget function itself comes from /etc/kvmd/override.d/90-glkvm-rs-rndis.yaml.

DAEMON=/usr/local/lib/glkvm-bridge/glkvm_bridge.py
PIDFILE=/run/glkvm-bridge.pid
DHCP_CONF=/etc/glkvm-bridge/udhcpd.conf
DHCP_PID=/run/glkvm-bridge-udhcpd.pid
CHAIN=glkvm-bridge-in

# kill_udhcpd ours|others: udhcpd catches SIGTERM without exiting, so follow up with KILL.
# (Every BusyBox tool is the same binary, so start-stop-daemon --exec can't tell them apart.)
kill_udhcpd() {
	pids=""
	for p in $(pgrep -x udhcpd); do
		if grep -q glkvm-bridge /proc/$p/cmdline 2>/dev/null; then
			[ "$1" = ours ] && pids="$pids $p"
		else
			[ "$1" = others ] && pids="$pids $p"
		fi
	done
	[ -n "$pids" ] || return 0
	kill $pids 2>/dev/null
	sleep 1
	kill -9 $pids 2>/dev/null
	return 0
}

link_up() {
	# GL's own USB network sharing adds NAT and a default route for the target: undo it.
	# Its stop leaves its udhcpd running (advertising the Comet as router), so kill that too.
	kvmd-rndis stop >/dev/null 2>&1
	kill_udhcpd others
	ifconfig usb0 192.168.5.1 netmask 255.255.255.0 up || return 1

	# The target may reach DHCP, ping, the relay (47474) and the downloads (47475) on the Comet,
	# nothing else (no web UI, no SSH, no forwarding).
	iptables -N $CHAIN 2>/dev/null || iptables -F $CHAIN
	iptables -A $CHAIN -m state --state ESTABLISHED,RELATED -j ACCEPT
	iptables -A $CHAIN -p udp --dport 67 -j ACCEPT
	iptables -A $CHAIN -p icmp -j ACCEPT
	iptables -A $CHAIN -p tcp --dport 47474 -j ACCEPT
	iptables -A $CHAIN -p tcp --dport 47475 -j ACCEPT
	iptables -A $CHAIN -j DROP
	iptables -C INPUT -i usb0 -j $CHAIN 2>/dev/null || iptables -I INPUT 1 -i usb0 -j $CHAIN
	iptables -C FORWARD -i usb0 -j DROP 2>/dev/null || iptables -I FORWARD 1 -i usb0 -j DROP

	touch /tmp/glkvm-bridge-udhcpd.leases
	kill_udhcpd ours
	/usr/sbin/udhcpd -f $DHCP_CONF >/dev/null 2>&1 &
	echo $! > $DHCP_PID
}

link_down() {
	kill_udhcpd ours
	rm -f $DHCP_PID
	iptables -D INPUT -i usb0 -j $CHAIN 2>/dev/null
	iptables -D FORWARD -i usb0 -j DROP 2>/dev/null
	iptables -F $CHAIN 2>/dev/null
	iptables -X $CHAIN 2>/dev/null
}

start() {
	printf "Starting glkvm-bridge: "
	link_up
	start-stop-daemon --start --quiet --background --make-pidfile --pidfile $PIDFILE \
		--exec /bin/sh -- -c "exec /usr/bin/python3 $DAEMON 2>&1 | logger -t glkvm-bridge"
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}

stop() {
	printf "Stopping glkvm-bridge: "
	start-stop-daemon --stop --quiet --pidfile $PIDFILE 2>/dev/null
	pkill -f "python3 $DAEMON" 2>/dev/null
	rm -f $PIDFILE /run/kvmd/glkvm-bridge.sock
	link_down
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
