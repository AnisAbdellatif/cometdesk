#!/bin/sh
# cometdesk-bridge: USB link for the target (no NAT, no routing) + relay daemon.
# The RNDIS gadget function itself comes from /etc/kvmd/override.d/90-cometdesk-rndis.yaml.

DAEMON=/usr/local/lib/cometdesk-bridge/cometdesk_bridge.py
PIDFILE=/run/cometdesk-bridge.pid
DHCP_CONF=/etc/cometdesk-bridge/udhcpd.conf
DHCP_PID=/run/cometdesk-bridge-udhcpd.pid
CHAIN=cometdesk-bridge-in
# Root-only runtime folder (lease file, client socket): /tmp and /run/kvmd are writable by
# other accounts, which could plant links there for root to follow.
RUNDIR=/run/cometdesk-bridge
PORTS="47474 47475"

# Determine unprivileged user if available (kvmd or nobody)
BRIDGE_USER=""
for u in kvmd nobody; do
	if id -u "$u" >/dev/null 2>&1; then
		BRIDGE_USER="$u"
		break
	fi
done

# kill_udhcpd ours|others: udhcpd catches SIGTERM without exiting, so follow up with KILL.
# (Every BusyBox tool is the same binary, so start-stop-daemon --exec can't tell them apart.)
kill_udhcpd() {
	pids=""
	for p in $(pgrep -x udhcpd); do
		if grep -q cometdesk-bridge /proc/$p/cmdline 2>/dev/null; then
			[ "$1" = ours ] && pids="$pids $p"
		else
			[ "$1" = others ] && pids="$pids $p"
		fi
	done
	[ -n "$pids" ] || return 0
	kill $pids 2>/dev/null
	sleep 1
	kill -9 $pids 2>/dev/null
	return 0
}

setup_firewall() {
	# The target may reach DHCP, ping, the relay (47474) and the downloads (47475) on the Comet,
	# nothing else (no web UI, no SSH, no forwarding).
	# Configured reliably regardless of whether usb0 exists yet (iptables allows rules on non-existent interfaces).
	iptables -N $CHAIN 2>/dev/null || iptables -F $CHAIN
	iptables -A $CHAIN -m state --state ESTABLISHED,RELATED -j ACCEPT
	iptables -A $CHAIN -p udp --dport 67 -j ACCEPT
	iptables -A $CHAIN -p icmp -j ACCEPT
	iptables -A $CHAIN -p tcp --dport 47474 -j ACCEPT
	iptables -A $CHAIN -p tcp --dport 47475 -j ACCEPT
	iptables -A $CHAIN -j DROP
	iptables -C INPUT -i usb0 -j $CHAIN 2>/dev/null || iptables -I INPUT 1 -i usb0 -j $CHAIN
	iptables -C FORWARD -i usb0 -j DROP 2>/dev/null || iptables -I FORWARD 1 -i usb0 -j DROP
	# The listeners bind 192.168.5.1, which Linux also answers on other interfaces: the relay
	# and downloads are for the USB link only.
	for p in $PORTS; do
		iptables -C INPUT ! -i usb0 -p tcp --dport "$p" -j DROP 2>/dev/null ||
			iptables -I INPUT 1 ! -i usb0 -p tcp --dport "$p" -j DROP
	done
}

link_up() {
	# GL's own USB network sharing adds NAT and a default route for the target: undo it.
	# Its stop leaves its udhcpd running (advertising the Comet as router), so kill that too.
	kvmd-rndis stop >/dev/null 2>&1
	kill_udhcpd others

	# Firewall setup must occur regardless of whether ifconfig usb0 succeeds immediately,
	# so traffic forwarding is never left open if the interface appears later.
	setup_firewall

	if ! ifconfig usb0 192.168.5.1 netmask 255.255.255.0 up; then
		return 1
	fi

	mkdir -p -m 755 $RUNDIR
	touch $RUNDIR/udhcpd.leases
	kill_udhcpd ours
	/usr/sbin/udhcpd -f $DHCP_CONF >/dev/null 2>&1 &
	echo $! > $DHCP_PID
	return 0
}

link_down() {
	kill_udhcpd ours
	rm -f $DHCP_PID
	iptables -D INPUT -i usb0 -j $CHAIN 2>/dev/null
	iptables -D FORWARD -i usb0 -j DROP 2>/dev/null
	for p in $PORTS; do
		iptables -D INPUT ! -i usb0 -p tcp --dport "$p" -j DROP 2>/dev/null
	done
	iptables -F $CHAIN 2>/dev/null
	iptables -X $CHAIN 2>/dev/null
}

start() {
	printf "Starting cometdesk-bridge: "
	# link_up brings usb0 up and installs the firewall. usb0 may legitimately not exist yet
	# (host not plugged in / gadget still enumerating), so a link_up failure is NOT fatal:
	# start the daemon regardless -- its agent/download listeners retry until usb0 appears.
	# Report DEGRADED (not OK) so a failed ifconfig/iptables is visible rather than hidden.
	if link_up; then
		link_status=OK
	else
		link_status=DEGRADED
		# At boot S99 scripts run in parallel and kvmd-otg may create usb0 a few seconds later:
		# keep retrying the link (not just the listeners) for up to 2 minutes.
		(
			for _ in $(seq 60); do
				sleep 2
				[ -e /sys/class/net/usb0 ] && link_up >/dev/null 2>&1 && exit 0
			done
		) </dev/null >/dev/null 2>&1 &
	fi
	user_opt=""
	[ -n "$BRIDGE_USER" ] && user_opt="--user $BRIDGE_USER"
	start-stop-daemon --start --quiet --background --make-pidfile --pidfile $PIDFILE \
		--exec /bin/sh -- -c "exec /usr/bin/python3 $DAEMON $user_opt 2>&1 | logger -t cometdesk-bridge"
	rc=$?
	if [ $rc != 0 ]; then
		echo "FAIL"
	elif [ "$link_status" = OK ]; then
		echo "OK"
	else
		echo "DEGRADED (USB link not ready; daemon started, will retry)"
	fi
}

stop() {
	printf "Stopping cometdesk-bridge: "
	start-stop-daemon --stop --quiet --pidfile $PIDFILE 2>/dev/null
	pkill -f "python3 $DAEMON" 2>/dev/null
	rm -f $PIDFILE $RUNDIR/bridge.sock /run/kvmd/cometdesk-bridge.sock
	link_down
	echo "OK"
}

case "$1" in
	start) start ;;
	stop) stop ;;
	restart|reload) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
exit 0
